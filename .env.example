# Copy this file to ".env" and fill in the values. See README.md, Step 5.

# Your PostgreSQL connection. Replace YOUR_POSTGRES_PASSWORD with the password
# you chose when installing PostgreSQL. The database "hardware_db" is created
# automatically by "npm run setup".
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/hardware_db?schema=public"

# A long random secret used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="PASTE_A_LONG_RANDOM_SECRET_HERE"

# Store location, used as the starting point for delivery maps.
STORE_LAT=11.4573
STORE_LNG=124.5638

# Gmail used to email customers when their account is approved or turned down.
# Use the store's Gmail address, and an App Password (not the normal password):
#   Google Account > Security > 2-Step Verification (turn it on) > App passwords
# Leave these blank and everything still works, just without the emails.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Optional: the site's public address, for the "Sign in" button in those emails.
# e.g. APP_URL="https://your-app.vercel.app"
APP_URL=""
