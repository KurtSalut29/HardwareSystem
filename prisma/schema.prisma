generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int               @id @default(autoincrement())
  username         String            @unique
  password         String
  role             String
  contact          String?
  // Drivers only: false while off duty (break, day off), so no delivery is assigned to them.
  onDuty           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  orders           Order[]           @relation("CustomerOrders")
  driverOrders     Order[]           @relation("DriverOrders")
  transactions     Transaction[]
  reports          Report[]          @relation("AuthoredReports")
  restocks         Restock[]         @relation("RecordedRestocks")
  handledOrders    Order[]           @relation("HandledOrders")
  restockBatches   RestockBatch[]    @relation("RecordedRestockBatches")
  stockAdjustments StockAdjustment[] @relation("RecordedStockAdjustments")
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  description   String?
  products      Product[]
  subcategories Subcategory[]
}

// A managed sub-group inside a category (e.g. Fasteners → Nails, Screws). Kept
// as its own table so a name is typed once and picked from a list after that,
// instead of free text that drifts ("Nails", "nails", "Nail").
model Subcategory {
  id         Int       @id @default(autoincrement())
  name       String
  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([categoryId, name])
}

model Product {
  id               Int               @id @default(autoincrement())
  name             String
  categoryId       Int
  category         Category          @relation(fields: [categoryId], references: [id])
  subcategoryId    Int?
  subcategory      Subcategory?      @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  price            Float
  unit             String            @default("pc")
  stock            Float             @default(0)
  image            String?
  description      String?
  createdAt        DateTime          @default(now())
  orderItems       OrderItem[]
  transactionItems TransactionItem[]
  restocks         Restock[]
  stockAdjustments StockAdjustment[]
}

model Transaction {
  id            Int               @id @default(autoincrement())
  userId        Int
  totalAmount   Float
  paymentMethod String
  dateTime      DateTime          @default(now())
  type          String
  // Delivery charge included in totalAmount, kept apart so reports can tell
  // product sales from delivery income.
  deliveryFee   Float             @default(0)
  user          User              @relation(fields: [userId], references: [id])
  items         TransactionItem[]
  // Online orders this sale settles: the one an "Online" sale was created for on
  // delivery, or the orders a staff member loaded into a POS checkout.
  orders        Order[]
}

model TransactionItem {
  id            Int         @id @default(autoincrement())
  transactionId Int
  productId     Int
  productName   String      @default("")
  quantity      Float
  price         Float
  product       Product     @relation(fields: [productId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model Order {
  id                      Int          @id @default(autoincrement())
  // Null for an order staff took by phone or at the counter for someone without
  // an account; customerName / customerContact hold who it is for.
  customerId              Int?
  customerName            String?
  customerContact         String?
  status                  String       @default("pending")
  // Products plus deliveryFee: what the customer pays.
  // Why the admin changed the computed delivery fee on this order, if they did.
  deliveryFeeNote         String?
  totalAmount             Float
  deliveryFee             Float        @default(0)
  dateTime                DateTime     @default(now())
  fulfillmentMode         String       @default("delivery")
  paymentMethod           String       @default("Cash")
  gcashNumber             String?
  gcashReference          String?
  paymentVerified         Boolean      @default(false)
  // What the customer has actually settled so far. Defaults to 0 and is
  // topped up to totalAmount when the balance is collected, so
  // totalAmount - amountPaid is always the outstanding balance.
  amountPaid              Float        @default(0)
  deliveryAddress         String?
  latitude                Float?
  longitude               Float?
  driverId                Int?
  assignedAt              DateTime?
  driverLat               Float?
  driverLng               Float?
  driverLocationUpdatedAt DateTime?
  // The staff member who last worked the order (confirmed it, assigned the
  // driver, marked it done). Its sale is credited to them in staff reports.
  handledById             Int?
  // The sale this order was recorded as. Set once, so an order is never counted
  // in the reports twice — whether it was rung up at the POS or delivered.
  transactionId           Int?
  // Proof of delivery: the driver's photo at handover, and when it happened.
  proofImage              String?
  deliveredAt             DateTime?
  customer                User?        @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  driver                  User?        @relation("DriverOrders", fields: [driverId], references: [id])
  handledBy               User?        @relation("HandledOrders", fields: [handledById], references: [id], onDelete: SetNull)
  transaction             Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  items                   OrderItem[]

  @@index([driverId, status])
  @@index([transactionId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Float
  price     Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

// A logged purchase of stock from a supplier. Recording one both keeps an
// audit trail of what the store bought and when, and is the only supported
// way stock goes up — the alternative (an admin just overwriting the number
// on the product form) leaves no record of where the stock came from or what
// it cost.
model Restock {
  id           Int           @id @default(autoincrement())
  productId    Int
  quantity     Float
  unitCost     Float
  totalCost    Float
  supplierName String?
  note         String?
  date         DateTime      @default(now())
  recordedById Int
  // The supplier delivery this line came in with. Null for purchases recorded
  // one product at a time before deliveries were grouped.
  batchId      Int?
  product      Product       @relation(fields: [productId], references: [id])
  recordedBy   User          @relation("RecordedRestocks", fields: [recordedById], references: [id])
  batch        RestockBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([productId, date])
  @@index([batchId])
}

// One delivery from a supplier — usually one delivery receipt (DR) with many
// products on it. Each product on it is a Restock line.
model RestockBatch {
  id           Int       @id @default(autoincrement())
  supplierName String?
  referenceNo  String?
  note         String?
  date         DateTime  @default(now())
  totalCost    Float
  recordedById Int
  recordedBy   User      @relation("RecordedRestockBatches", fields: [recordedById], references: [id])
  items        Restock[]

  @@index([date])
}

// A stock change that isn't a sale or a purchase: damaged, lost, returned, or a
// correction after a physical count. Recorded with a reason so every change to
// stock has a trail.
model StockAdjustment {
  id           Int      @id @default(autoincrement())
  productId    Int
  change       Float
  stockAfter   Float
  reason       String
  note         String?
  date         DateTime @default(now())
  recordedById Int
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  recordedBy   User     @relation("RecordedStockAdjustments", fields: [recordedById], references: [id])

  @@index([productId, date])
}

model Setting {
  key   String @id
  value String
}

// A sales/accomplishment report a staff member compiles for a period and sends
// to the admin. The figures are snapshotted at send time rather than recomputed
// on read, so a report always shows what was reported, even if a transaction is
// edited later.
model Report {
  id                Int       @id @default(autoincrement())
  authorId          Int
  author            User      @relation("AuthoredReports", fields: [authorId], references: [id])
  title             String
  periodStart       DateTime
  periodEnd         DateTime
  totalSales        Float
  totalTransactions Int
  itemsSold         Float
  cashTotal         Float
  gcashTotal        Float
  otherTotal        Float
  // JSON snapshot of the line detail (top products + the transactions counted).
  payload           String
  note              String?
  status            String    @default("sent")
  createdAt         DateTime  @default(now())
  readAt            DateTime?

  @@index([authorId, createdAt])
}

// An uploaded image (GCash QR, product photo), kept in the database rather than
// on the server's disk. Hosted deployments such as Vercel cannot write files at
// runtime, so a file saved to public/uploads there was never served.
model Upload {
  id        Int      @id @default(autoincrement())
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())
}
