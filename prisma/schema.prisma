generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  password     String
  role         String
  contact      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orders       Order[]       @relation("CustomerOrders")
  driverOrders Order[]       @relation("DriverOrders")
  transactions Transaction[]
  reports      Report[]      @relation("AuthoredReports")
  restocks     Restock[]     @relation("RecordedRestocks")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  products    Product[]
}

model Product {
  id               Int               @id @default(autoincrement())
  name             String
  categoryId       Int
  category         Category          @relation(fields: [categoryId], references: [id])
  subcategory      String?
  price            Float
  unit             String            @default("pc")
  stock            Float             @default(0)
  image            String?
  description      String?
  createdAt        DateTime          @default(now())
  orderItems       OrderItem[]
  transactionItems TransactionItem[]
  restocks         Restock[]
}

model Transaction {
  id            Int               @id @default(autoincrement())
  userId        Int
  totalAmount   Float
  paymentMethod String
  dateTime      DateTime          @default(now())
  type          String
  user          User              @relation(fields: [userId], references: [id])
  items         TransactionItem[]
}

model TransactionItem {
  id            Int         @id @default(autoincrement())
  transactionId Int
  productId     Int
  productName   String      @default("")
  quantity      Float
  price         Float
  product       Product     @relation(fields: [productId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model Order {
  id                      Int         @id @default(autoincrement())
  customerId              Int
  status                  String      @default("pending")
  totalAmount             Float
  dateTime                DateTime    @default(now())
  fulfillmentMode         String      @default("delivery")
  paymentMethod           String      @default("Cash")
  gcashNumber             String?
  gcashReference          String?
  paymentVerified         Boolean     @default(false)
  // What the customer has actually settled so far. Defaults to 0 and is
  // topped up to totalAmount when the balance is collected, so
  // totalAmount - amountPaid is always the outstanding balance.
  amountPaid              Float       @default(0)
  deliveryAddress         String?
  latitude                Float?
  longitude               Float?
  driverId                Int?
  assignedAt              DateTime?
  driverLat               Float?
  driverLng               Float?
  driverLocationUpdatedAt DateTime?
  customer                User        @relation("CustomerOrders", fields: [customerId], references: [id])
  driver                  User?       @relation("DriverOrders", fields: [driverId], references: [id])
  items                   OrderItem[]

  @@index([driverId, status])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Float
  price     Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

// A logged purchase of stock from a supplier. Recording one both keeps an
// audit trail of what the store bought and when, and is the only supported
// way stock goes up — the alternative (an admin just overwriting the number
// on the product form) leaves no record of where the stock came from or what
// it cost.
model Restock {
  id           Int      @id @default(autoincrement())
  productId    Int
  quantity     Float
  unitCost     Float
  totalCost    Float
  supplierName String?
  note         String?
  date         DateTime @default(now())
  recordedById Int
  product      Product  @relation(fields: [productId], references: [id])
  recordedBy   User     @relation("RecordedRestocks", fields: [recordedById], references: [id])

  @@index([productId, date])
}

model Setting {
  key   String @id
  value String
}

// A sales/accomplishment report a staff member compiles for a period and sends
// to the admin. The figures are snapshotted at send time rather than recomputed
// on read, so a report always shows what was reported, even if a transaction is
// edited later.
model Report {
  id                Int       @id @default(autoincrement())
  authorId          Int
  author            User      @relation("AuthoredReports", fields: [authorId], references: [id])
  title             String
  periodStart       DateTime
  periodEnd         DateTime
  totalSales        Float
  totalTransactions Int
  itemsSold         Float
  cashTotal         Float
  gcashTotal        Float
  otherTotal        Float
  // JSON snapshot of the line detail (top products + the transactions counted).
  payload           String
  note              String?
  status            String    @default("sent")
  createdAt         DateTime  @default(now())
  readAt            DateTime?

  @@index([authorId, createdAt])
}
