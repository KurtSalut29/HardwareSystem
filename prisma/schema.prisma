generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int               @id @default(autoincrement())
  username         String            @unique
  password         String
  role             String
  contact          String?
  // Sign-in address. Customers register with it; staff without one still sign in by username.
  email            String?           @unique
  // A customer's full name from registration. Their username is built from it.
  firstName        String?
  middleName       String?
  lastName         String?
  suffix           String?
  // Customers start "pending" and can't sign in until the admin approves them
  // ("approved") or turns them down ("rejected", reason in statusNote).
  accountStatus    String            @default("approved")
  statusNote       String?
  reviewedAt       DateTime?
  reviewedById     Int?
  // The customer's usual drop-off point, pinned on the map at registration.
  defaultAddress   String?
  defaultLat       Float?
  defaultLng       Float?
  // Wrong-password counter: five in a row locks sign-in for a while.
  failedLogins     Int               @default(0)
  lockedUntil      DateTime?
  // Drivers only: false while off duty (break, day off), so no delivery is assigned to them.
  onDuty           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  orders           Order[]           @relation("CustomerOrders")
  driverOrders     Order[]           @relation("DriverOrders")
  transactions     Transaction[]
  reports          Report[]          @relation("AuthoredReports")
  restocks         Restock[]         @relation("RecordedRestocks")
  handledOrders    Order[]           @relation("HandledOrders")
  restockBatches   RestockBatch[]    @relation("RecordedRestockBatches")
  stockAdjustments StockAdjustment[] @relation("RecordedStockAdjustments")
  savedAddresses   SavedAddress[]
  paymentsCreated  Payment[]         @relation("PaymentsCreated")
  paymentsReviewed Payment[]         @relation("PaymentsReviewed")
  // Customers: whether payment and refund updates are also sent by email.
  emailUpdates     Boolean           @default(true)
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  description   String?
  products      Product[]
  subcategories Subcategory[]
}

// A managed sub-group inside a category (e.g. Fasteners → Nails, Screws). Kept
// as its own table so a name is typed once and picked from a list after that,
// instead of free text that drifts ("Nails", "nails", "Nail").
model Subcategory {
  id         Int       @id @default(autoincrement())
  name       String
  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([categoryId, name])
}

model Product {
  id               Int               @id @default(autoincrement())
  name             String
  categoryId       Int
  category         Category          @relation(fields: [categoryId], references: [id])
  subcategoryId    Int?
  subcategory      Subcategory?      @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  // Maker, e.g. Holcim, Boysen, Stanley. Optional: plenty of hardware is unbranded.
  brand            String?
  price            Float
  unit             String            @default("pc")
  stock            Float             @default(0)
  image            String?
  description      String?
  createdAt        DateTime          @default(now())
  orderItems       OrderItem[]
  transactionItems TransactionItem[]
  restocks         Restock[]
  stockAdjustments StockAdjustment[]
}

model Transaction {
  id            Int               @id @default(autoincrement())
  userId        Int
  totalAmount   Float
  paymentMethod String
  dateTime      DateTime          @default(now())
  type          String
  // Delivery charge included in totalAmount, kept apart so reports can tell
  // product sales from delivery income.
  deliveryFee   Float             @default(0)
  user          User              @relation(fields: [userId], references: [id])
  items         TransactionItem[]
  // Online orders this sale settles: the one an "Online" sale was created for on
  // delivery, or the orders a staff member loaded into a POS checkout.
  orders        Order[]
}

model TransactionItem {
  id            Int         @id @default(autoincrement())
  transactionId Int
  productId     Int
  productName   String      @default("")
  quantity      Float
  price         Float
  product       Product     @relation(fields: [productId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model Order {
  id                      Int          @id @default(autoincrement())
  // Null for an order staff took by phone or at the counter for someone without
  // an account; customerName / customerContact hold who it is for.
  customerId              Int?
  customerName            String?
  customerContact         String?
  status                  String       @default("pending")
  // Products plus deliveryFee: what the customer pays.
  // Why the admin changed the computed delivery fee on this order, if they did.
  deliveryFeeNote         String?
  totalAmount             Float
  deliveryFee             Float        @default(0)
  dateTime                DateTime     @default(now())
  fulfillmentMode         String       @default("delivery")
  paymentMethod           String       @default("Cash")
  gcashNumber             String?
  gcashReference          String?
  paymentVerified         Boolean      @default(false)
  // What the customer has actually settled so far. Defaults to 0 and is
  // topped up to totalAmount when the balance is collected, so
  // totalAmount - amountPaid is always the outstanding balance.
  amountPaid              Float        @default(0)
  deliveryAddress         String?
  latitude                Float?
  longitude               Float?
  // Someone other than the customer receiving the delivery, and the exact spot
  // (landmark, gate, floor). All optional.
  recipientName           String?
  recipientContact        String?
  deliveryNotes           String?
  // When the remaining balance should be settled (set when a downpayment is approved).
  paymentDueAt            DateTime?
  // Who cancelled ("customer" or "store"), when, and why.
  cancelledAt             DateTime?
  cancelledBy             String?
  cancelReason            String?
  driverId                Int?
  assignedAt              DateTime?
  driverLat               Float?
  driverLng               Float?
  driverLocationUpdatedAt DateTime?
  // The staff member who last worked the order (confirmed it, assigned the
  // driver, marked it done). Its sale is credited to them in staff reports.
  handledById             Int?
  // The sale this order was recorded as. Set once, so an order is never counted
  // in the reports twice — whether it was rung up at the POS or delivered.
  transactionId           Int?
  // Proof of delivery: the driver's photo at handover, and when it happened.
  proofImage              String?
  deliveredAt             DateTime?
  customer                User?        @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  driver                  User?        @relation("DriverOrders", fields: [driverId], references: [id])
  handledBy               User?        @relation("HandledOrders", fields: [handledById], references: [id], onDelete: SetNull)
  transaction             Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  payments                Payment[]

  @@index([driverId, status])
  @@index([transactionId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Float
  price     Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

// A logged purchase of stock from a supplier. Recording one both keeps an
// audit trail of what the store bought and when, and is the only supported
// way stock goes up — the alternative (an admin just overwriting the number
// on the product form) leaves no record of where the stock came from or what
// it cost.
model Restock {
  id           Int           @id @default(autoincrement())
  productId    Int
  quantity     Float
  unitCost     Float
  totalCost    Float
  supplierName String?
  note         String?
  date         DateTime      @default(now())
  recordedById Int
  // The supplier delivery this line came in with. Null for purchases recorded
  // one product at a time before deliveries were grouped.
  batchId      Int?
  product      Product       @relation(fields: [productId], references: [id])
  recordedBy   User          @relation("RecordedRestocks", fields: [recordedById], references: [id])
  batch        RestockBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([productId, date])
  @@index([batchId])
}

// One delivery from a supplier — usually one delivery receipt (DR) with many
// products on it. Each product on it is a Restock line.
model RestockBatch {
  id           Int       @id @default(autoincrement())
  supplierName String?
  referenceNo  String?
  note         String?
  date         DateTime  @default(now())
  totalCost    Float
  recordedById Int
  recordedBy   User      @relation("RecordedRestockBatches", fields: [recordedById], references: [id])
  items        Restock[]

  @@index([date])
}

// A stock change that isn't a sale or a purchase: damaged, lost, returned, or a
// correction after a physical count. Recorded with a reason so every change to
// stock has a trail.
model StockAdjustment {
  id           Int      @id @default(autoincrement())
  productId    Int
  change       Float
  stockAfter   Float
  reason       String
  note         String?
  date         DateTime @default(now())
  recordedById Int
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  recordedBy   User     @relation("RecordedStockAdjustments", fields: [recordedById], references: [id])

  @@index([productId, date])
}

model Setting {
  key   String @id
  value String
}

// Road distance between two map points from the routing service (OSRM), so the
// same drop-off is never looked up twice and a quote shown at checkout matches
// the fee charged when the order is saved. Keys are coordinates rounded to
// about 10 m ("11.4573,124.5638").
model RouteDistance {
  id        Int      @id @default(autoincrement())
  fromKey   String
  toKey     String
  km        Float
  minutes   Float?
  createdAt DateTime @default(now())

  @@unique([fromKey, toKey])
}

// A sales/accomplishment report a staff member compiles for a period and sends
// to the admin. The figures are snapshotted at send time rather than recomputed
// on read, so a report always shows what was reported, even if a transaction is
// edited later.
model Report {
  id                Int       @id @default(autoincrement())
  authorId          Int
  author            User      @relation("AuthoredReports", fields: [authorId], references: [id])
  title             String
  periodStart       DateTime
  periodEnd         DateTime
  totalSales        Float
  totalTransactions Int
  itemsSold         Float
  cashTotal         Float
  gcashTotal        Float
  otherTotal        Float
  // JSON snapshot of the line detail (top products + the transactions counted).
  payload           String
  note              String?
  status            String    @default("sent")
  createdAt         DateTime  @default(now())
  readAt            DateTime?

  @@index([authorId, createdAt])
}

// An uploaded image (GCash QR, product photo), kept in the database rather than
// on the server's disk. Hosted deployments such as Vercel cannot write files at
// runtime, so a file saved to public/uploads there was never served.
model Upload {
  id        Int      @id @default(autoincrement())
  mimeType  String
  data      Bytes
  size      Int
  // Private files (GCash receipt screenshots) are only served to staff and to
  // the person who uploaded them. Product photos and the store QR stay public.
  private   Boolean  @default(false)
  ownerId   Int?
  createdAt DateTime @default(now())
}

// Every payment toward an order, and every refund. An order's amountPaid is the
// total of its approved payments, so this is the history behind that number.
//  - kind "payment": status pending (waiting for staff to check the receipt),
//    approved, or rejected (note says why).
//  - kind "refund": money owed back after a cancellation; pending until staff
//    send it, then sent (reference = the store's GCash reference).
model Payment {
  id             Int       @id @default(autoincrement())
  orderId        Int
  kind           String    @default("payment")
  method         String
  // Payment: what the customer says they sent. Refund: what is owed back.
  amount         Float
  // Payment: what staff confirmed arrived (may differ from amount).
  amountReceived Float?
  reference      String?
  // Payment: the GCash number it came from. Refund: the number it is sent to.
  accountNumber  String?
  proofImage     String?
  status         String    @default("pending")
  note           String?
  createdById    Int?
  reviewedById   Int?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy      User?     @relation("PaymentsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy     User?     @relation("PaymentsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([kind, status])
}

// A customer's saved drop-off points besides their home (e.g. work, a relative's
// house), each with optional landmark and the person who receives there.
model SavedAddress {
  id               Int      @id @default(autoincrement())
  userId           Int
  label            String
  address          String
  latitude         Float
  longitude        Float
  notes            String?
  recipientName    String?
  recipientContact String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
